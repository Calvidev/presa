# Residential proxy (optional — highly recommended for production scale)
# Providers: Bright Data, Oxylabs, ThorData, Smartproxy
PROXY_ENABLED=false
PROXY_HOST=brd.superproxy.io
PROXY_PORT=22225
PROXY_USER=brd-customer-xxx
PROXY_PASS=your_password_here

# Scraper tuning
DB_PATH=str_data.db
HEADLESS=true
CALENDAR_DAYS=90        # how many future days of calendar to fetch per listing
MAX_LISTINGS=200        # max listings to scrape per city/platform run
LOG_LEVEL=INFO
